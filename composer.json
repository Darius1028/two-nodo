{
  "name": "institucion/record-academico",
  "description": "Sistema de Registro Académico - Doctrine + SQL Server + Keycloak",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "chillerlan/php-qrcode": "^6.0",
    "doctrine/dbal": "^3.7",
    "doctrine/migrations": "^3.7",
    "doctrine/orm": "^2.17",
    "jumbojett/openid-connect-php": "^1.0",
    "setasign/fpdf": "^1.8",
    "symfony/cache": "^7.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"!is_dir('var/cache') && mkdir('var/cache', 0777, true);\"",
      "@php -r \"!is_dir('var/log') && mkdir('var/log', 0777, true);\""
    ],
    "test": "@php vendor/phpunit/phpunit/phpunit"
  }
}
