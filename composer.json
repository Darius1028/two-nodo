{
  "name": "institucion/record-academico",
  "description": "Sistema de Registro Académico - Doctrine + SQL Server + Keycloak",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "doctrine/dbal": "^3.7",
    "doctrine/migrations": "^3.7",
    "doctrine/orm": "^2.17",
    "jumbojett/openid-connect-php": "^1.0",
    "setasign/fpdf": "^1.8",
    "symfony/cache": "^7.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "mkdir -p var/cache var/log"
    ]
  }
}
