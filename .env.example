# App
# perfil de validacion prod produccion y dev desarrollo
APP_ENV=prod
APP_DEBUG=false

# SQL Server donde se encuentra la tabla de record academico
DB_HOST=
DB_PORT=
DB_INSTANCE=
DB_NAME=record_academico_db
DB_USER=
DB_PASS=

# Keycloak OIDC
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://xxxxxxxxx/callback.php
# roles que manejara los perfiles de usuario que se logea
KEYCLOAK_ROLE_ADMIN=ADMIN_ACADEMICO
KEYCLOAK_ROLE_USER=SECRE_ACADEMICO
EXTERNAL_ROLES_APP_ALIAS=SEC-ACAD

# Modo workspace: "public" o "protected"
WORKSPACE_ACCESS_MODE=protected

# Proxies confiables (IP o CIDR separados por coma): F5 / Nginx / balanceador
# que habla directo con PHP-FPM. Únicamente cuando REMOTE_ADDR coincide con
# una de estas entradas se confían las cabeceras X-Forwarded-For / X-Real-IP
# para resolver la IP real del cliente (rate limiting, auditoría).
# IMPORTANTE: si queda vacío, se usa siempre REMOTE_ADDR y se ignoran las
# cabeceras de reenvío (evita el bypass de rate limit por X-Forwarded-For).
# Ejemplo: TRUSTED_PROXIES=10.10.10.10,172.16.0.0/16
TRUSTED_PROXIES=

# --- Roles resueltos por cédula desde una base externa (LDAP/AD solo autentica) ---
# Nombre del claim en el token de Keycloak que trae la cédula del usuario
# (depende de cómo esté mapeado el atributo de LDAP/AD en Keycloak).
KEYCLOAK_CEDULA_CLAIM=cedula

# Conexión al SQL Server externo donde vive la tabla de roles (distinto al
# de academic_records).
EXTERNAL_ROLES_DB_HOST=
EXTERNAL_ROLES_DB_PORT=
EXTERNAL_ROLES_DB_INSTANCE=
EXTERNAL_ROLES_DB_NAME=
EXTERNAL_ROLES_DB_USER=
EXTERNAL_ROLES_DB_PASS=

# url donde redireccionara el QR al escanear
QR_BASE_URL=https://xxxxxxx/wordpress/verificar-record/

# hadoop
REPOSITORIO_DOCUMENTAL_URL=https://desa-api-estable.funcionjudicial.gob.ec/CJ-REPOSITORIO-DOCUMENTAL-SERVICE/api/documento/command/phoenix/save
REPOSITORIO_DOCUMENTAL_IP_ORIGEN=desa-estable-procesamientosentencias.funcionjudicial.gob.ec
