# IMPORTANTE: en producción usar APP_ENV=prod y APP_DEBUG=false.
# Con APP_DEBUG=true los errores muestran stack traces con rutas internas.
APP_ENV=dev
APP_DEBUG=true
DB_HOST=10.1.27.25
DB_PORT=1435
DB_INSTANCE=DESA02
DB_NAME=record_academico_db
DB_USER=USR_OPE_RECORD_ACADEMICO
DB_PASS=USR_OPE_RECORD_ACADEMICO
DB_ENCRYPT=false
DB_LOGIN_TIMEOUT=30

KEYCLOAK_SERVER_URL=https://desa-sso-c5r.funcionjudicial.gob.ec
KEYCLOAK_REALM=cj-funcionarios
KEYCLOAK_CLIENT_ID=jurisprudencia-cnj-web
KEYCLOAK_REDIRECT_URI=http://localhost/callback.php
KEYCLOAK_ROLE_ADMIN=ROLE_ADMIN
KEYCLOAK_ROLE_USER=ROLE_USER
WORKSPACE_ACCESS_MODE=protected

# --- Roles resueltos por cédula desde una base externa (LDAP/AD solo autentica) ---
# Nombre del claim en el token de Keycloak que trae la cédula del usuario
# (depende de cómo esté mapeado el atributo de LDAP/AD en Keycloak).
KEYCLOAK_CEDULA_CLAIM=cedula

# Conexión al SQL Server externo donde vive la tabla de roles (distinto al
# de academic_records).
EXTERNAL_ROLES_DB_HOST=10.1.27.25
EXTERNAL_ROLES_DB_PORT=1435
EXTERNAL_ROLES_DB_INSTANCE=DESA02
EXTERNAL_ROLES_DB_NAME=PORTAL_APLICATIVOS_CJ
EXTERNAL_ROLES_DB_USER=USR_ADM_DES_ALL
EXTERNAL_ROLES_DB_PASS=uadacjt2012

# Ajustar a los nombres reales de tabla/columnas de esa base externa.
EXTERNAL_ROLES_TABLE=usuario_roles
EXTERNAL_ROLES_CEDULA_COLUMN=cedula
EXTERNAL_ROLES_ROLE_COLUMN=rol

REPOSITORIO_DOCUMENTAL_URL=https://desa-api-estable.funcionjudicial.gob.ec/CJ-REPOSITORIO-DOCUMENTAL-SERVICE/api/documento/command/phoenix/save
