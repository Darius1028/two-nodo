# Perfil de contingencia: un disco/sistema de archivos por servidor.
# Copie como minio.single-disk.env en cada nodo. No lo guarde en Git.
# La pérdida del disco de un nodo implica la pérdida de dos fragmentos; por eso
# una copia de seguridad externa y verificada es obligatoria.
MINIO_NODE_NAME=pchquit01dweb14.fj.local
MINIO_CLUSTER_SCHEME=http
MINIO_CERTS_DIR=/etc/academic-minio/certs
MINIO_CONSOLE_ADDRESS=127.0.0.1:9001
MINIO_ROOT_USER_FILE=/etc/academic-minio/secrets/root-user
MINIO_ROOT_PASSWORD_FILE=/etc/academic-minio/secrets/root-password

# Ambos directorios viven deliberadamente en el mismo sistema de archivos.
# Deben estar vacíos antes del primer inicio y no deben reutilizar datos de
# otra instalación MinIO.
MINIO_DATA_1=/var/lib/academic-minio/data1
MINIO_DATA_2=/var/lib/academic-minio/data2
