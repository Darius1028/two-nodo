# Copie este archivo como minio.env en CADA servidor. Todos los valores deben
# coincidir salvo MINIO_NODE_NAME. No guarde minio.env en Git.

# Servidor 1: app-record-01
# Servidor 2: app-record-02
# El nombre debe coincidir con el hostname del sistema operativo. Resuélvalos
# mediante DNS interno o /etc/hosts en ambos nodos antes de iniciar MinIO.
MINIO_NODE_NAME=app-record-01

# TLS es obligatorio para producción. Los certificados de cada servidor deben
# validar app-record-01/app-record-02 y compartir una CA confiable.
MINIO_CLUSTER_SCHEME=https
MINIO_CERTS_DIR=/etc/academic-minio/certs
MINIO_CONSOLE_ADDRESS=127.0.0.1:9001

# Los dos servidores deben tener archivos con el mismo contenido. Manténgalos
# fuera del repositorio, con permisos 0600. La aplicación debe utilizar otra
# credencial de mínimo privilegio.
MINIO_ROOT_USER_FILE=/etc/academic-minio/secrets/root-user
MINIO_ROOT_PASSWORD_FILE=/etc/academic-minio/secrets/root-password

# Ocho discos forman un único erasure set EC:4 (cuatro discos por servidor).
# Cada ruta debe ser un mount point persistente, exclusivo y distinto.
MINIO_DISK_1=/mnt/minio/disk1
MINIO_DISK_2=/mnt/minio/disk2
MINIO_DISK_3=/mnt/minio/disk3
MINIO_DISK_4=/mnt/minio/disk4
